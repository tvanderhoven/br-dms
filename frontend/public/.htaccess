# Für die Online-Demo auf einem Apache-Webhosting (z. B. IONOS Webhosting Pro):
# BR-DMS ist eine Single-Page-App (React Router). Ohne diese Regel liefert der
# Server bei einem Direktaufruf einer Unterseite (z. B. /dashboard) oder einem
# Reload dort einen 404 statt der App. Alles, was keine echte Datei ist, geht
# daher auf index.html, der Router im Browser übernimmt dann die Anzeige.
RewriteEngine On
RewriteBase /
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# Caching: index.html immer neu laden, damit Besucher nach einem Update sofort
# die neue Version bekommen (sie verweist auf die neuen Dateien in assets/).
# Die Dateien in assets/ tragen eine Prüfsumme im Namen und ändern sich bei
# jedem Build, sie dürfen daher lange im Browser-Cache bleiben.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
