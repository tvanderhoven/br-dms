// ================================================================
//  BR-DMS – Prisma Schema
//  DSGVO-konformes Dokumenten-Management für Betriebsräte
// ================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================================================
//  ENUMS
// ================================================================

enum Role {
  VORSITZ
  STELLVERTRETER
  MITGLIED
  ERSATZMITGLIED
  ADMIN
  // Stark eingeschränkte Rolle: nur Lesezugriff auf Sitzungen/Protokolle
  // (z.B. JAV-Vertretung, die im Raum ist, aber nicht Betriebsratsmitglied ist)
  JAV
  // Schwerbehindertenvertretung (§ 178 SGB IX) – dieselbe Einschränkung wie JAV
  SBV
}

enum Prioritaet {
  HOCH
  MITTEL
  NIEDRIG
}

// Für Wahlergebnis-Daten (Geschlechterquote §15 Abs. 2 BetrVG) – bewusst binär,
// da die gesetzliche Minderheitenquote sich auf diese beiden Gruppen bezieht.
enum Geschlecht {
  MAENNLICH
  WEIBLICH
}

// Für Themen-Backlog (Kanban-Board in der Aufgaben-Ansicht). Optional/nullable,
// da normale Aufgaben weiterhin nur über "erledigt" laufen und nicht am Board teilnehmen.
enum KanbanStatus {
  BACKLOG
  IN_BEARBEITUNG
  ERLEDIGT
}

// Kanban-Spalten für die normale Aufgaben-Seite (unabhängig vom Themen-Backlog,
// siehe KanbanStatus oben – eigenständige ToDos haben kanbanStatus=null und
// nutzen stattdessen dieses Feld)
enum AufgabenStatus {
  NEU
  IN_BEARBEITUNG
  AUF_HOLD
  ERLEDIGT
}

enum Sichtbarkeit {
  PRIVAT
  OEFFENTLICH
}

enum AufgabeTyp {
  PROJEKT
  AUFGABE
}

enum Kategorie {
  ANHOERUNG_99
  ANHOERUNG_102
  BEWERBUNG
  BEWERBUNG_ALTERNATIV
  ZEITMODELL_87
  PROTOKOLL
  BETRIEBSVEREINBARUNG
  SONSTIGES
  ABMAHNUNG
  ARBEITGEBER_INFO
  ARBEITSSCHUTZ
  SCHRIFTVERKEHR
  GESCHAEFTSORDNUNG
}

enum DokumentStatus {
  AKTIV
  ARCHIVIERT
  LOESCHVORMERKUNG
  GELOESCHT
}

enum FristTyp {
  ANHOERUNG_99_WOCHE
  ANHOERUNG_102_ORDENTLICH
  ANHOERUNG_102_AUSSERORDENTLICH
  WIDERSPRUCH
  ZEITMODELL_87_WOCHE
  BETRIEBSVERSAMMLUNG_43
  WAHL
  BENUTZERDEFINIERT
}

enum FristStatus {
  OFFEN
  ERLEDIGT
  ABGELAUFEN
}

enum SitzungStatus {
  ENTWURF
  TAGESORDNUNG_FIXIERT
  PROTOKOLL_ENTWURF
  PROTOKOLL_FINAL
  ABGESCHLOSSEN
  ABGESAGT
}

enum TopStatus {
  OFFEN
  BESCHLOSSEN
  ABGELEHNT
  VERTAGT
  ZUR_KENNTNIS
}

enum AnwesenheitsStatus {
  ANWESEND
  ABWESEND_ENTSCHULDIGT
  ABWESEND_UNENTSCHULDIGT
  ERSATZ_FUER
}

enum Stimme {
  JA
  NEIN
  ENTHALTUNG
  NICHT_TEILGENOMMEN
}

enum NachrichtTyp {
  NORMAL
  TAGESORDNUNG
  PROTOKOLL
  SYSTEM
}

enum AuditAktion {
  LOGIN
  LOGOUT
  DOKUMENT_ERSTELLT
  DOKUMENT_ANGESEHEN
  DOKUMENT_HERUNTERGELADEN
  DOKUMENT_AKTUALISIERT
  DOKUMENT_GELOESCHT
  DOKUMENT_METADATEN_GEAENDERT
  DOKUMENT_TAG_GEAENDERT
  DOKUMENT_ALIAS_GEAENDERT
  DOKUMENT_TOP_GEAENDERT
  DOKUMENT_AUFGABE_ERSTELLT
  INBOX_DOKUMENT_GELESEN
  WATCHFOLDER_DATEI_EMPFANGEN
  FRIST_ERSTELLT
  FRIST_ERLEDIGT
  BENUTZER_ERSTELLT
  BENUTZER_DEAKTIVIERT
  BENUTZER_GELOESCHT
  PASSWORT_GEAENDERT
  ZUGRIFF_VERWEIGERT
  SITZUNG_ERSTELLT
  SITZUNG_AKTUALISIERT
  SITZUNG_FIXIERT
  SITZUNG_PROTOKOLL_GESTARTET
  SITZUNG_FINALISIERT
  SITZUNG_GELOESCHT
  ABSTIMMUNG_ERSTELLT
  ABSTIMMUNG_FINALISIERT
  NACHRICHT_GESENDET
  WATCHFOLDER_FEHLER
  WISSEN_ERSTELLT
  WISSEN_AKTUALISIERT
  WISSEN_GELOESCHT
  DOKUMENT_VERSION_ERSTELLT
  GEHALTSTABELLE_GELOESCHT
  GEHALTSTABELLE_EINTRAEGE_GELOESCHT
  BV_ERSTELLT
  BV_AKTUALISIERT
  BV_GELOESCHT
  EINSTELLUNG_GEAENDERT
  SITZUNG_SCAN_HOCHGELADEN
  SITZUNG_SCAN_GELOESCHT
  SITZUNG_ABGESCHLOSSEN
  SITZUNGSPAKET_HERUNTERGELADEN
  GREMIUM_ERSTELLT
  GREMIUM_AKTUALISIERT
  GREMIUM_GELOESCHT
  FREMDPROTOKOLL_ERSTELLT
  FREMDPROTOKOLL_AKTUALISIERT
  FREMDPROTOKOLL_GELOESCHT
  FREMDPROTOKOLL_HERUNTERGELADEN
  GREMIUM_MITGLIED_HINZUGEFUEGT
  GREMIUM_MITGLIED_ENTFERNT
  GESCHAEFTSORDNUNG_ERSTELLT
  GESCHAEFTSORDNUNG_AKTUALISIERT
  GESCHAEFTSORDNUNG_GELOESCHT
}

// ================================================================
//  BENUTZER
// ================================================================

model Benutzer {
  id              String    @id @default(uuid())
  email           String    @unique
  // Zweitadresse für Einladungen (z. B. br-name@… / jav-name@…); leer = Hauptadresse
  einladungEmail  String?   @map("einladung_email")
  name            String
  passwortHash    String    @map("passwort_hash")
  rolle           Role
  aktiv           Boolean   @default(true)

  istVertretungFuer String?                      @map("ist_vertretung_fuer")
  vertretungErhalten Anwesenheit[]              @relation("VertretungErhalten")

  // Wahlergebnis der letzten BR-Wahl (einmalig aus dem Wahlprotokoll übertragen) –
  // Basis für den automatischen Ersatzmitglieder-Nachrück-Vorschlag inkl. Quoten-Warnung.
  geschlecht      Geschlecht? @map("geschlecht")
  wahlReihenfolge Int?        @map("wahl_reihenfolge")

  letzterLogin    DateTime? @map("letzter_login")
  erstelltAm      DateTime  @default(now()) @map("erstellt_am")
  aktualisiertAm  DateTime  @updatedAt @map("aktualisiert_am")

  dokumente             Dokument[]            @relation("HochgeladenVon")
  auditLogs             AuditLog[]
  erledigtefristen      Frist[]               @relation("ErlegigtVon")
  sitzungen             Sitzung[]             @relation("SitzungenErstellt")
  abstimmungsStimmen    AbstimmungsStimme[]   @relation("StimmeAbgegeben")
  gesendeteNachrichten  Nachricht[]           @relation("NachrichtAbsender")
  empfangeneNachrichten Nachricht[]           @relation("NachrichtEmpfaenger")
  kommentare            Kommentar[]           @relation("KommentarAutor")
  anwesenheiten         Anwesenheit[]
  passwortResets        PasswortReset[]
  erstellteAufgaben     Aufgabe[]       @relation("AufgabeErstellt")
  zugewieseneAufgaben   Aufgabe[]       @relation("AufgabeZugewiesen")
  wissenEintraege        WissensEintrag[] @relation("WissensErstelltVon")
  ressourcen             Ressource[]      @relation("RessourceErstellt")
  betriebsvereinbarungenErstellt Betriebsvereinbarung[] @relation("BVErstellt")
  geschaeftsordnungenErstellt Geschaeftsordnung[] @relation("GeschaeftsordnungErstellt")
  schulungenErstellt     Schulungstermin[] @relation("SchulungErstellt")
  kummerkastenBearbeitet KummerkastenEintrag[]
  sitzungScansHochgeladen SitzungScan[]    @relation("SitzungScanHochgeladen")
  fremdprotokolleHochgeladen Fremdprotokoll[] @relation("FremdprotokollHochgeladenVon")
  gremienMitgliedschaften GremiumMitglied[]

  @@map("benutzer")
}

model PasswortReset {
  id          String   @id @default(uuid())
  benutzerId  String   @map("benutzer_id")
  token       String   @unique
  gueltigBis  DateTime @map("gueltig_bis")
  genutzt     Boolean  @default(false)
  erstelltAm  DateTime @default(now()) @map("erstellt_am")
  benutzer    Benutzer @relation(fields: [benutzerId], references: [id], onDelete: Cascade)

  @@map("passwort_resets")
}

// ================================================================
//  AUFGABEN
// ================================================================

model Aufgabe {
  id              String       @id @default(uuid())
  titel           String
  beschreibung    String?
  beschreibungJson Json?       @map("beschreibung_json")
  typ             AufgabeTyp   @default(AUFGABE)
  prioritaet      Prioritaet   @default(MITTEL)
  startDatum      DateTime?    @map("start_datum")
  endDatum        DateTime?    @map("end_datum")
  faelligAm       DateTime?    @map("faellig_am")
  farbe           String?
  erledigt        Boolean      @default(false)
  erledigtAm      DateTime?    @map("erledigt_am")
  sichtbarkeit    Sichtbarkeit @default(OEFFENTLICH)

  // Themen-Backlog / Kanban-Board – null = normale Aufgabe, nimmt nicht am Board teil
  kanbanStatus    KanbanStatus? @map("kanban_status")

  // Kanban-Board auf der Aufgaben-Seite selbst (Neu/In Bearbeitung/Auf Hold/Erledigt) –
  // wird mit "erledigt" synchron gehalten (siehe routes/aufgaben.ts)
  aufgabenStatus  AufgabenStatus @default(NEU) @map("aufgaben_status")

  // Hierarchie: Ober-/Unterprojekte und Aufgaben unter Projekten
  oberProjektId   String?      @map("ober_projekt_id")
  oberProjekt     Aufgabe?     @relation("AufgabeHierarchie", fields: [oberProjektId], references: [id], onDelete: SetNull)
  unterElemente   Aufgabe[]    @relation("AufgabeHierarchie")

  erstelltVonId   String       @map("erstellt_von_id")
  erstelltVon     Benutzer     @relation("AufgabeErstellt", fields: [erstelltVonId], references: [id])

  zugewiesenAnId  String?      @map("zugewiesen_an_id")
  zugewiesenAn    Benutzer?    @relation("AufgabeZugewiesen", fields: [zugewiesenAnId], references: [id])

  dokumentId      String?      @map("dokument_id")
  dokument        Dokument?    @relation(fields: [dokumentId], references: [id], onDelete: SetNull)

  // Verknüpfung: Thema wurde in einen Sitzungs-TOP übernommen
  topId           String?      @map("top_id")
  top             TOP?         @relation(fields: [topId], references: [id], onDelete: SetNull)

  erstelltAm      DateTime     @default(now()) @map("erstellt_am")
  aktualisiertAm  DateTime     @updatedAt @map("aktualisiert_am")

  @@map("aufgaben")
}

// ================================================================
//  DOKUMENTE
// ================================================================

model Dokument {
  id             String        @id @default(uuid())
  titel          String
  kategorie      Kategorie
  status         DokumentStatus @default(AKTIV)

  dateiname      String
  speicherpfad   String        @map("speicher_pfad")
  verschlPfad    String        @map("verschl_pfad")
  dateigroesse   Int           @map("datei_groesse")
  mimeTyp        String        @map("mime_typ")
  pruefsumme     String

  alias          String?
  tags           String[]
  textinhalt     String?       @map("textinhalt")
  inboxGelesen   Boolean       @default(false) @map("inbox_gelesen")
  inboxGelesenAm DateTime?     @map("inbox_gelesen_am")
  inboxQuelle    String?       @map("inbox_quelle")

  aktenzeichen   String?       @map("aktenzeichen")
  beschreibung   String?
  vertraulich    Boolean       @default(false)

  deleteAt        DateTime?     @map("delete_at")
  geloeschtAm     DateTime?     @map("geloescht_am")
  loeschgrund     String?       @map("loeschgrund")
  wiedervorlageAm DateTime?     @map("wiedervorlage_am")

  hochgeladenVonId String      @map("hochgeladen_von_id")
  hochgeladenVon   Benutzer    @relation("HochgeladenVon", fields: [hochgeladenVonId], references: [id])

  erstelltAm     DateTime      @default(now()) @map("erstellt_am")
  aktualisiertAm DateTime      @updatedAt @map("aktualisiert_am")

  versionen         DokumentVersion[]
  fristen           Frist[]
  auditLogs         AuditLog[]
  topVerknuepfungen TopDokument[]
  kommentare        Kommentar[]
  aufgaben          Aufgabe[]
  betriebsvereinbarungen Betriebsvereinbarung[]
  geschaeftsordnungen    Geschaeftsordnung[]

  @@index([deleteAt, status])
  @@index([kategorie, status])
  @@map("dokumente")
}

model DokumentVersion {
  id             String   @id @default(uuid())
  dokumentId     String   @map("dokument_id")
  dokument       Dokument @relation(fields: [dokumentId], references: [id], onDelete: Cascade)

  version        Int
  dateiname      String
  speicherpfad   String   @map("speicher_pfad")
  verschlPfad    String   @map("verschl_pfad")
  dateigroesse   Int      @map("datei_groesse")
  pruefsumme     String
  aenderungsnotiz String? @map("aenderungsnotiz")

  erstelltAm     DateTime @default(now()) @map("erstellt_am")
  erstelltVonId  String   @map("erstellt_von_id")

  @@unique([dokumentId, version])
  @@map("dokument_versionen")
}

// ================================================================
//  FRISTEN (§ 99 & § 102 BetrVG)
// ================================================================

model Frist {
  id             String      @id @default(uuid())
  // Optional: Fristen können auch ohne Dokument existieren (z. B. Wahl,
  // Betriebsversammlung, ASA) – dann trägt "bezeichnung" den Titel.
  dokumentId     String?     @map("dokument_id")
  dokument       Dokument?   @relation(fields: [dokumentId], references: [id], onDelete: Cascade)

  typ            FristTyp
  status         FristStatus @default(OFFEN)
  faelligAm      DateTime    @map("faellig_am")
  bezeichnung    String?
  notiz          String?

  erledigtAm     DateTime?   @map("erledigt_am")
  erledigtVonId  String?     @map("erledigt_von_id")
  erledigtVon    Benutzer?   @relation("ErlegigtVon", fields: [erledigtVonId], references: [id])

  erstelltVonId  String?     @map("erstellt_von_id")

  // Automatisch aus einer Wahl berechnet (siehe lib/wahlFristen.ts) – wahlSchritt
  // identifiziert den Schritt, damit Datumsänderungen die Frist aktualisieren statt verdoppeln
  wahlId         String?     @map("wahl_id")
  wahl           Wahl?       @relation(fields: [wahlId], references: [id], onDelete: Cascade)
  wahlSchritt    String?     @map("wahl_schritt")

  erstelltAm     DateTime    @default(now()) @map("erstellt_am")

  @@index([faelligAm, status])
  @@map("fristen")
}

// ================================================================
//  WAHLEN (BR / JAV) – Werkzeug des Betriebsrats, nicht des Wahlvorstands
// ================================================================

enum WahlArt {
  BR
  JAV
}

enum WahlVerfahren {
  NORMAL
  VEREINFACHT
}

model Wahl {
  id               String        @id @default(uuid())
  titel            String
  art              WahlArt
  verfahren        WahlVerfahren
  // Erster Tag der Stimmabgabe bzw. Tag der Wahlversammlung (vereinfachtes Verfahren)
  stimmabgabeAm    DateTime      @map("stimmabgabe_am")
  // Ende der Amtszeit des amtierenden Gremiums – Grundlage für die Bestellung des Wahlvorstands
  amtszeitEnde     DateTime?     @map("amtszeit_ende")
  // Tatsächlicher Erlass des Wahlausschreibens; ohne Angabe wird mit dem spätesten Termin gerechnet
  ausschreibenAm   DateTime?     @map("ausschreiben_am")
  notiz            String?

  // Wählerliste (lib/waehlerliste.ts): nur JAV – dual Studierende als "zur Berufsausbildung
  // Beschäftigte" zählen (hängt vom Vertrag ab, daher je Wahl entscheidbar)
  dualStudierendeAlsAzubis Boolean @default(false) @map("dual_studierende_als_azubis")
  // Von Hand aus der Wählerliste genommene Mitarbeiter-IDs (z. B. leitende Angestellte)
  ausgeschlossen   String[]      @default([])

  // Stufe 3: übernommenes Wahlergebnis (Rangfolge, Stimmen, Mitglied/Ersatz) – bleibt als Historie stehen
  ergebnis              Json?
  ergebnisUebernommenAm DateTime? @map("ergebnis_uebernommen_am")
  konstituierendeSitzungId String? @map("konstituierende_sitzung_id")

  // Vorhaben im Zeitplan (Aufgabe vom Typ PROJEKT); bleibt beim Löschen der Wahl erhalten
  vorhabenId       String?       @map("vorhaben_id")

  erstelltVonId    String        @map("erstellt_von_id")
  erstelltAm       DateTime      @default(now()) @map("erstellt_am")
  aktualisiertAm   DateTime      @updatedAt @map("aktualisiert_am")

  fristen          Frist[]

  @@map("wahlen")
}

// ================================================================
//  SITZUNGSMANAGEMENT
// ================================================================

model Sitzung {
  id             String        @id @default(uuid())
  titel          String
  sitzungsdatum  DateTime      @map("sitzungsdatum")
  ort            String?
  // ORDENTLICH | AUSSERORDENTLICH | KONSTITUIEREND | BETRIEBSVERSAMMLUNG (siehe lib/sitzungstypen.ts)
  sitzungstyp    String        @default("ORDENTLICH")
  status         SitzungStatus @default(ENTWURF)
  notizen        String?
  // Nur Betriebsversammlung: Teilnehmerzahl statt Anwesenheitsliste
  teilnehmerzahl Int?

  // Gremium-Zuordnung (Paket 5): leer = Betriebsrat (Standardfall, keine Datenmigration
  // nötig). Andere Gremien (Ausschüsse, JAV, SBV, ...) können ihre Sitzungen optional
  // voll im System führen, statt nur ein Fremdprotokoll abzulegen.
  gremiumId      String?       @map("gremium_id")
  gremium        Gremium?      @relation(fields: [gremiumId], references: [id], onDelete: Restrict)

  erstelltVonId  String        @map("erstellt_von_id")
  erstelltVon    Benutzer      @relation("SitzungenErstellt", fields: [erstelltVonId], references: [id])

  erstelltAm     DateTime      @default(now()) @map("erstellt_am")
  aktualisiertAm DateTime      @updatedAt @map("aktualisiert_am")

  versionen      SitzungVersion[]
  tops           TOP[]
  auditLogs      AuditLog[]
  nachrichten    Nachricht[]
  kommentare     Kommentar[]
  anwesenheiten  Anwesenheit[]
  einladungen    EinladungVersand[]
  scans          SitzungScan[]
  protocolBlocks ProtocolBlock[]
  gehaltsstufenEintraege GehaltsstufenEintrag[]
  zeitmodellEintraege    ZeitmodellEintrag[]
  ueberstundenEintraege  UeberstundenEintrag[]

  @@index([sitzungsdatum, status])
  @@map("sitzungen")
}

// Versandnachweis der Einladungen (§ 29 Abs. 2 BetrVG) – ein Eintrag je Mail.
// Name, Adresse und Vertretung als Momentaufnahme, damit der Nachweis auch nach
// Änderungen am Benutzer stimmt; deshalb keine Relation zum Benutzer.
model EinladungVersand {
  id             String   @id @default(uuid())
  sitzungId      String   @map("sitzung_id")
  sitzung        Sitzung  @relation(fields: [sitzungId], references: [id], onDelete: Cascade)
  benutzerId     String?  @map("benutzer_id")
  name           String
  adresse        String
  rolle          String
  vertretungFuer String?  @map("vertretung_fuer")   // Name des verhinderten Mitglieds
  mitAnhang      Boolean  @default(false) @map("mit_anhang")
  zusatz         String?                             // freier Text dieses Versands (z. B. Online-Meeting-Link)
  erfolgreich    Boolean
  fehler         String?
  versendetAm    DateTime @default(now()) @map("versendet_am")
  versendetVonId String   @map("versendet_von_id")
  versendetVon   String   @map("versendet_von")      // Name, als Momentaufnahme

  @@index([sitzungId])
  @@map("einladung_versand")
}

// Gescannte Unterschriften (§ 29 Abs. 2, Nachweis der Protokollgenehmigung) – je Sitzung
// höchstens ein Scan pro Typ; eine kombinierte Datei darf beide Typen füllen (zwei Zeilen,
// zwei verschlüsselte Kopien). Ablage wie bei Dokument/DokumentVersion (AES-256-GCM).
enum SitzungScanTyp {
  ANWESENHEITSLISTE
  PROTOKOLL_UNTERSCHRIFTEN
}

model SitzungScan {
  id               String         @id @default(uuid())
  sitzungId        String         @map("sitzung_id")
  sitzung          Sitzung        @relation(fields: [sitzungId], references: [id], onDelete: Cascade)

  typ              SitzungScanTyp

  dateiname        String
  speicherpfad     String         @map("speicher_pfad")
  verschlPfad      String         @map("verschl_pfad")
  dateigroesse     Int            @map("datei_groesse")
  mimeTyp          String         @map("mime_typ")
  pruefsumme       String

  hochgeladenAm    DateTime       @default(now()) @map("hochgeladen_am")
  hochgeladenVonId String         @map("hochgeladen_von_id")
  hochgeladenVon   Benutzer       @relation("SitzungScanHochgeladen", fields: [hochgeladenVonId], references: [id])

  @@unique([sitzungId, typ])
  @@map("sitzung_scans")
}

// Wartende Scans aus dem Watch-Folder-Unterordner "protokoll_scan", bevor sie per Klick im
// Eingang einer Sitzung + einem SitzungScanTyp zugeordnet werden. Bewusst ohne Relation zu
// Sitzung/Benutzer – anonym, bis jemand sie zuordnet oder verwirft (verarbeiteDokument/Dokument
// passt hier nicht: kein Kategorie, keine Aufbewahrungsfrist, kein OCR-Volltext nötig).
model ScanEingang {
  id           String   @id @default(uuid())

  dateiname    String
  speicherpfad String   @map("speicher_pfad")
  verschlPfad  String   @map("verschl_pfad")
  dateigroesse Int      @map("datei_groesse")
  mimeTyp      String   @map("mime_typ")
  pruefsumme   String

  erkanntAm    DateTime @default(now()) @map("erkannt_am")

  @@map("scan_eingang")
}

// ================================================================
//  GREMIEN UND FREMDPROTOKOLLE (Paket 5)
// ================================================================

// Katalog der Gremien, die der BR NICHT selbst im System führt (ASA, Wirtschafts-
// ausschuss, Gesamtbetriebsrat, ...) oder deren Sitzungen optional doch im System
// geführt werden (dann über Sitzung.gremiumId). Der Betriebsrat selbst taucht hier
// bewusst nicht auf – seine Sitzungen bleiben exklusiv auf der Sitzungen-Seite.
model Gremium {
  id              String   @id @default(uuid())
  name            String   @unique
  rechtsgrundlage String?                            // z.B. "§ 28 BetrVG", frei
  bemerkung       String?
  aktiv           Boolean  @default(true)            // Archivieren statt löschen, wenn verknüpft

  erstelltAm      DateTime @default(now()) @map("erstellt_am")
  aktualisiertAm  DateTime @updatedAt @map("aktualisiert_am")

  sitzungen       Sitzung[]
  fremdprotokolle Fremdprotokoll[]
  mitglieder      GremiumMitglied[]

  @@map("gremien")
}

// Mitgliedschaft eines Benutzers in einem (Nicht-BR-)Gremium – steuert die automatische
// Anwesenheits-Vorausfüllung einer Sitzung dieses Gremiums (siehe lib/sitzungAnlegen.ts).
model GremiumMitglied {
  id         String   @id @default(uuid())
  gremiumId  String   @map("gremium_id")
  gremium    Gremium  @relation(fields: [gremiumId], references: [id], onDelete: Cascade)
  benutzerId String   @map("benutzer_id")
  benutzer   Benutzer @relation(fields: [benutzerId], references: [id], onDelete: Cascade)

  erstelltAm DateTime @default(now()) @map("erstellt_am")

  @@unique([gremiumId, benutzerId])
  @@map("gremium_mitglieder")
}

// Protokoll eines Gremiums, das der BR nicht selbst führt – ein einzelnes hochgeladenes
// Dokument mit Gremium + Datum, ohne TOPs/Anwesenheit. Eigenes Modell statt neue
// Dokument-Kategorie, da gremiumId+datum echte Pflichtfelder sind, die im Dokument-
// Upload nicht existieren. Verschlüsselung wie bei Dokument (AES-256-GCM).
model Fremdprotokoll {
  id               String   @id @default(uuid())
  gremiumId        String   @map("gremium_id")
  gremium          Gremium  @relation(fields: [gremiumId], references: [id], onDelete: Restrict)

  datum            DateTime
  titel            String
  bemerkung        String?
  vertraulich      Boolean  @default(false)

  dateiname        String
  speicherpfad     String   @map("speicher_pfad")
  verschlPfad      String   @map("verschl_pfad")
  dateigroesse     Int      @map("datei_groesse")
  mimeTyp          String   @map("mime_typ")
  pruefsumme       String

  hochgeladenVonId String   @map("hochgeladen_von_id")
  hochgeladenVon   Benutzer @relation("FremdprotokollHochgeladenVon", fields: [hochgeladenVonId], references: [id])

  erstelltAm       DateTime @default(now()) @map("erstellt_am")
  aktualisiertAm   DateTime @updatedAt @map("aktualisiert_am")

  @@index([gremiumId, datum])
  @@map("fremdprotokolle")
}

model SitzungVersion {
  id             String   @id @default(uuid())
  sitzungId      String   @map("sitzung_id")
  sitzung        Sitzung  @relation(fields: [sitzungId], references: [id], onDelete: Cascade)

  versionNummer  String   @map("version_nummer")
  // TAGESORDNUNG_ENTWURF | TAGESORDNUNG_FIXIERT | PROTOKOLL_ENTWURF | PROTOKOLL_FINAL
  typ            String
  readonly       Boolean  @default(false)

  // TipTap-JSON-Inhalt dieser Version (Gesamtdokument)
  inhaltsJson    Json?    @map("inhalts_json")

  // PDF (generiert beim Fixieren bzw. Finalisieren)
  pdfDateiname   String?  @map("pdf_dateiname")
  pdfPfad        String?  @map("pdf_pfad")
  pdfErstelltAm  DateTime? @map("pdf_erstellt_am")

  // Digitaler Zeitstempel bei Finalisierung
  zeitstempel    String?  // SHA-256(inhaltsJson + finalisiertAm) als Integritätsnachweis

  einladungVersendetAm DateTime? @map("einladung_versendet_am")
  finalisiertAm        DateTime? @map("finalisiert_am")
  finalisiertVonId     String?   @map("finalisiert_von_id")

  erstelltVonId  String   @map("erstellt_von_id")
  erstelltAm     DateTime @default(now()) @map("erstellt_am")

  @@unique([sitzungId, versionNummer])
  @@map("sitzung_versionen")
}

model ProtocolBlock {
  id             String        @id @default(uuid())
  sitzungId      String        @map("sitzung_id")
  sitzung        Sitzung       @relation(fields: [sitzungId], references: [id], onDelete: Cascade)

  typ            String        // TEXT, VOTE, ATTENDANCE, TOP_REFERENCE
  topId          String?       @map("top_id")
  top            TOP?          @relation(fields: [topId], references: [id], onDelete: Cascade)

  inhalt         String?
  inhaltsJson    Json?         @map("inhalts_json")

  reihenfolge    Int           @default(0)

  erstelltAm     DateTime      @default(now()) @map("erstellt_am")
  aktualisiertAm DateTime      @updatedAt @map("aktualisiert_am")

  @@index([sitzungId, reihenfolge])
  @@map("protocol_blocks")
}

model Anwesenheit {
  id              String             @id @default(uuid())
  sitzungId       String             @map("sitzung_id")
  sitzung         Sitzung            @relation(fields: [sitzungId], references: [id], onDelete: Cascade)

  benutzerId      String             @map("benutzer_id")
  benutzer        Benutzer           @relation(fields: [benutzerId], references: [id], onDelete: Cascade)

  status          AnwesenheitsStatus
  vertretungFuerId String?          @map("vertretung_fuer_id")
  vertretungFuer  Benutzer?         @relation("VertretungErhalten", fields: [vertretungFuerId], references: [id], onDelete: SetNull)

  erstelltAm      DateTime           @default(now()) @map("erstellt_am")
  aktualisiertAm  DateTime           @updatedAt @map("aktualisiert_am")

  @@unique([sitzungId, benutzerId])
  @@map("anwesenheiten")
}

model TOP {
  id             String    @id @default(uuid())
  sitzungId      String    @map("sitzung_id")
  sitzung        Sitzung   @relation(fields: [sitzungId], references: [id], onDelete: Cascade)

  nummer         Int
  protocolBlocks ProtocolBlock[]
  titel          String

  // Plaintext-Fallback (bleibt für Kompatibilität)
  inhalt         String?
  ergebnis       String?

  // TipTap-JSON (Reich-Text-Editor-Inhalt)
  inhaltsJson    Json?     @map("inhalts_json")   // Tagesordnungs-Beschreibung
  ergebnisJson   Json?     @map("ergebnis_json")  // Protokoll-Ergebnis

  status         TopStatus @default(OFFEN)

  // Spontan-TOP: nachträglich in Sitzung aufgenommen
  spontan        Boolean   @default(false)

  // Für stark eingeschränkte Rollen (z.B. JAV) ausgeblendet
  vertraulich    Boolean   @default(false)

  dokumente      TopDokument[]
  abstimmung     Abstimmung?
  beschluesse    Beschluss[]
  kommentare     Kommentar[]
  themen         Aufgabe[]       // Backlog-Themen, die in diesen TOP übernommen wurden

  erstelltAm     DateTime  @default(now()) @map("erstellt_am")
  aktualisiertAm DateTime  @updatedAt @map("aktualisiert_am")

  @@unique([sitzungId, nummer])
  @@map("tops")
}

model TopDokument {
  id              String   @id @default(uuid())
  topId           String   @map("top_id")
  top             TOP      @relation(fields: [topId], references: [id], onDelete: Cascade)

  dokumentId      String   @map("dokument_id")
  dokument        Dokument @relation(fields: [dokumentId], references: [id], onDelete: Cascade)

  hinweis         String?
  verknuepftVonId String   @map("verknuepft_von_id")
  erstelltAm      DateTime @default(now()) @map("erstellt_am")

  @@unique([topId, dokumentId])
  @@map("top_dokumente")
}

// ================================================================
//  BESCHLÜSSE (mehrere pro TOP, revisionssicher)
// ================================================================

model Beschluss {
  id              String    @id @default(uuid())
  topId           String    @map("top_id")
  top             TOP       @relation(fields: [topId], references: [id], onDelete: Cascade)

  antragstext     String    @map("antragstext")
  rechtsgrundlage String    @default("Sonstige Beschlussfassung") @map("rechtsgrundlage")
  reihenfolge     Int       @default(0)

  jaStimmen       Int       @default(0) @map("ja_stimmen")
  neinStimmen     Int       @default(0) @map("nein_stimmen")
  enthaltungen    Int       @default(0)
  nichtTeilgenommen Int     @default(0) @map("nicht_teilgenommen")
  anwesend        Int       @default(0)
  ergebnis        String?

  finalisiert      Boolean   @default(false)
  finalisiertAm    DateTime? @map("finalisiert_am")
  finalisiertVonId String?   @map("finalisiert_von_id")

  erstelltVonId   String    @map("erstellt_von_id")
  erstelltAm      DateTime  @default(now()) @map("erstellt_am")
  aktualisiertAm  DateTime  @updatedAt @map("aktualisiert_am")

  stimmen         BeschlussStimme[]

  @@index([topId, reihenfolge])
  @@map("beschluesse")
}

model BeschlussStimme {
  id             String    @id @default(uuid())
  beschlussId    String    @map("beschluss_id")
  beschluss      Beschluss @relation(fields: [beschlussId], references: [id], onDelete: Cascade)

  benutzerId     String    @map("benutzer_id")
  stimme         Stimme
  vertretungFuer String?   @map("vertretung_fuer")

  erstelltAm     DateTime  @default(now()) @map("erstellt_am")

  @@unique([beschlussId, benutzerId])
  @@map("beschluss_stimmen")
}

// ================================================================
//  ABSTIMMUNGEN (Voting)
// ================================================================

model Abstimmung {
  id              String    @id @default(uuid())
  topId           String    @unique @map("top_id")
  top             TOP       @relation(fields: [topId], references: [id], onDelete: Cascade)

  rechtsgrundlage String    @map("rechtsgrundlage") // "§ 87 BetrVG", "§ 99 BetrVG", etc.
  fragestellung   String    @map("fragestellung")

  // Berechnete Ergebnisse (denormalisiert für Performance)
  jaStimmen       Int       @default(0) @map("ja_stimmen")
  neinStimmen     Int       @default(0) @map("nein_stimmen")
  enthaltungen    Int       @default(0)
  anwesend        Int       @default(0)   // stimmberechtigt anwesend
  // ANGENOMMEN | ABGELEHNT | UNENTSCHIEDEN | null (offen)
  ergebnis        String?

  finalisiert     Boolean   @default(false)
  finalisiertAm   DateTime? @map("finalisiert_am")
  finalisiertVonId String?  @map("finalisiert_von_id")

  erstelltVonId   String    @map("erstellt_von_id")
  erstelltAm      DateTime  @default(now()) @map("erstellt_am")
  aktualisiertAm  DateTime  @updatedAt @map("aktualisiert_am")

  stimmen         AbstimmungsStimme[]

  @@map("abstimmungen")
}

model AbstimmungsStimme {
  id              String     @id @default(uuid())
  abstimmungId    String     @map("abstimmung_id")
  abstimmung      Abstimmung @relation(fields: [abstimmungId], references: [id], onDelete: Cascade)

  benutzerId      String     @map("benutzer_id")
  benutzer        Benutzer   @relation("StimmeAbgegeben", fields: [benutzerId], references: [id])

  stimme          Stimme
  // Wird gesetzt wenn ein Ersatzmitglied stellvertretend abstimmt
  stellvertretungFuer String? @map("stellvertretung_fuer")

  erstelltAm      DateTime   @default(now()) @map("erstellt_am")

  @@unique([abstimmungId, benutzerId])
  @@map("abstimmungs_stimmen")
}

// ================================================================
//  INTERNE NACHICHTEN (Member-Inbox)
// ================================================================

model Nachricht {
  id           String       @id @default(uuid())
  betreff      String
  inhalt       String
  typ          NachrichtTyp @default(NORMAL)

  // null = Systemnachricht
  absenderId   String?      @map("absender_id")
  absender     Benutzer?    @relation("NachrichtAbsender", fields: [absenderId], references: [id], onDelete: SetNull)

  empfaengerId String       @map("empfaenger_id")
  empfaenger   Benutzer     @relation("NachrichtEmpfaenger", fields: [empfaengerId], references: [id], onDelete: Cascade)

  sitzungId    String?      @map("sitzung_id")
  sitzung      Sitzung?     @relation(fields: [sitzungId], references: [id], onDelete: SetNull)

  // Anhang: generiertes PDF (verschlüsselt gespeichert wie Dokumente)
  pdfDateiname String?      @map("pdf_dateiname")
  pdfPfad      String?      @map("pdf_pfad")

  gelesen      Boolean      @default(false)
  gelesenAm    DateTime?    @map("gelesen_am")

  erstelltAm   DateTime     @default(now()) @map("erstellt_am")

  @@index([empfaengerId, gelesen, erstelltAm])
  @@index([sitzungId])
  @@map("nachrichten")
}

// ================================================================
//  KOMMENTARE (pro Sitzung / TOP / Dokument)
// ================================================================

model Kommentar {
  id         String    @id @default(uuid())
  inhalt     String                       // Plaintext-Fallback (Anzeige/Suche/PDF)
  inhaltJson Json?     @map("inhalt_json") // TipTap-JSON (Rich-Text-Inhalt)

  autorId    String    @map("autor_id")
  autor      Benutzer  @relation("KommentarAutor", fields: [autorId], references: [id], onDelete: Cascade)

  // Genau eines der drei Felder ist gesetzt
  sitzungId  String?   @map("sitzung_id")
  sitzung    Sitzung?  @relation(fields: [sitzungId], references: [id], onDelete: Cascade)

  topId      String?   @map("top_id")
  top        TOP?      @relation(fields: [topId], references: [id], onDelete: Cascade)

  dokumentId String?   @map("dokument_id")
  dokument   Dokument? @relation(fields: [dokumentId], references: [id], onDelete: Cascade)

  erstelltAm     DateTime @default(now()) @map("erstellt_am")
  aktualisiertAm DateTime @updatedAt @map("aktualisiert_am")

  @@index([sitzungId, erstelltAm])
  @@index([topId, erstelltAm])
  @@index([dokumentId, erstelltAm])
  @@map("kommentare")
}

// ================================================================
//  AUDIT-LOG (revisionssicher, unveränderlich)
// ================================================================

model AuditLog {
  id           String      @id @default(uuid())

  benutzerId   String?     @map("benutzer_id")
  benutzer     Benutzer?   @relation(fields: [benutzerId], references: [id], onDelete: SetNull)

  dokumentId   String?     @map("dokument_id")
  dokument     Dokument?   @relation(fields: [dokumentId], references: [id], onDelete: SetNull)

  sitzungId    String?     @map("sitzung_id")
  sitzung      Sitzung?    @relation(fields: [sitzungId], references: [id], onDelete: SetNull)

  wissensEintragId String?       @map("wissen_id")
  wissensEintrag   WissensEintrag? @relation(fields: [wissensEintragId], references: [id], onDelete: SetNull)

  aktion       AuditAktion
  ip           String?
  userAgent    String?     @map("user_agent")
  details      Json?

  zeitpunkt    DateTime    @default(now())

  @@index([benutzerId, zeitpunkt])
  @@index([dokumentId, zeitpunkt])
  @@index([sitzungId, zeitpunkt])
  @@index([aktion, zeitpunkt])
  @@index([wissensEintragId, zeitpunkt])
  @@map("audit_logs")
}

// ================================================================
//  SITZUNGSVORLAGEN
// ================================================================

model SitzungsVorlage {
  id             String       @id @default(uuid())
  name           String
  beschreibung   String?
  erstelltAm     DateTime     @default(now()) @map("erstellt_am")
  aktualisiertAm DateTime     @updatedAt @map("aktualisiert_am")
  tops           VorlageTOP[]

  @@map("sitzungs_vorlagen")
}

model VorlageTOP {
  id          String          @id @default(uuid())
  vorlageId   String          @map("vorlage_id")
  vorlage     SitzungsVorlage @relation(fields: [vorlageId], references: [id], onDelete: Cascade)
  titel       String
  inhalt      String?
  inhaltsJson Json?           @map("inhalts_json")
  reihenfolge Int             @default(0)
  erstelltAm  DateTime        @default(now()) @map("erstellt_am")

  @@index([vorlageId, reihenfolge])
  @@map("vorlage_tops")
}

// ================================================================
//  SYSTEM-EINSTELLUNGEN (Key-Value)
// ================================================================

model SystemEinstellung {
  schluessel     String   @id
  wert           String
  aktualisiertAm DateTime @updatedAt @map("aktualisiert_am")

  @@map("system_einstellungen")
}

// ================================================================
//  AUFBEWAHRUNGSFRISTEN (konfigurierbar)
// ================================================================

model Aufbewahrungsregel {
  id           String    @id @default(uuid())
  kategorie    Kategorie @unique
  tage         Int
  rechtsgrundlage String? @map("rechtsgrundlage")
  beschreibung String?

  erstelltAm   DateTime  @default(now()) @map("erstellt_am")
  aktualisiertAm DateTime @updatedAt @map("aktualisiert_am")

  @@map("aufbewahrungsregeln")
}

// ================================================================
//  RESSOURCEN (externe Links)
// ================================================================

model Ressource {
  id            String   @id @default(uuid())
  titel         String
  url           String
  beschreibung  String?
  // GESETZ | KI_WERKZEUG | BEHOERDE | VORLAGE | SONSTIGES
  kategorie     String   @default("SONSTIGES")
  tags          String[] @default([])

  erstelltVonId String   @map("erstellt_von_id")
  erstelltVon   Benutzer @relation("RessourceErstellt", fields: [erstelltVonId], references: [id])

  erstelltAm    DateTime @default(now()) @map("erstellt_am")
  aktualisiertAm DateTime @updatedAt @map("aktualisiert_am")

  @@index([kategorie])
  @@index([erstelltAm])
  @@map("ressourcen")
}

// ================================================================
//  WISSENSDATENBANK
// ================================================================

model WissensEintrag {
  id        String   @id @default(uuid())
  titel     String
  inhalt    String
  inhaltJson Json?   @map("inhalt_json") // TipTap-JSON (Rich-Text), inhalt bleibt für Suche/Vorschau gepflegt

  herkunft  String   @default("MANUELL") // MANUELL | PROTOKOLL_EXTRAKT
  quelle    Json?    // { sitzungId, topId, protocolBlockId }

  kategorien String[] @default([]) // Tags/Schlagworte zur Kategorisierung
  loesung    String?  // Beschreibung der Lösung / des Ergebnisses
  loesungJson Json?   @map("loesung_json") // TipTap-JSON (Rich-Text) für loesung

  erstelltVonId String   @map("erstellt_von_id")
  erstelltVon   Benutzer @relation("WissensErstelltVon", fields: [erstelltVonId], references: [id])

  erstelltAm     DateTime @default(now()) @map("erstellt_am")
  aktualisiertAm DateTime @updatedAt @map("aktualisiert_am")

  auditLogs      AuditLog[]

  @@index([erstelltAm])
  @@index([erstelltVonId])
  @@map("wissen")
}

// ================================================================
//  GEHALTSTABELLE (Gehaltsstufen-Historie je Mitarbeiter)
// ================================================================

model Abteilung {
  id             String   @id @default(uuid())
  name           String   @unique

  erstelltAm     DateTime @default(now()) @map("erstellt_am")
  aktualisiertAm DateTime @updatedAt @map("aktualisiert_am")

  mitarbeiter    Mitarbeiter[]

  @@map("abteilungen")
}

enum Beschaeftigungsart {
  MITARBEITER
  AZUBI
  STUDENT         // studentische Hilfskraft (stundenweise, kein duales Studium)
  DUALER_STUDENT  // duales Studium – weder Azubi noch studentische Hilfskraft
  ZEITARBEITER
}

model Mitarbeiter {
  id             String     @id @default(uuid())
  vorname        String
  nachname       String

  pnr            String?    @unique
  eintritt       DateTime?
  austritt       DateTime?
  standort       String?
  // Für Wahlen: Wahlberechtigung JAV (unter 18 bzw. Azubis unter 25, § 60 BetrVG) und BR (ab 16, § 7).
  // Kommt aus den Listen der Personalabteilung (CSV-Import, Spalte "Geburtsdatum").
  geburtsdatum   DateTime?
  // Für Wahlen: Wählerliste getrennt nach Geschlechtern (§ 2 WO), Minderheitengeschlecht (§ 15 BetrVG).
  // null = nicht angegeben bzw. divers. Kommt aus der Personalliste (CSV-Spalte "Geschlecht" oder "Anrede").
  geschlecht     Geschlecht?

  // z.B. Geschäftsführung, Ausbildung – bewusst ohne Gehaltsstufen-Tracking,
  // wird deshalb nicht in der "Mitarbeiter ohne Gehaltseintrag"-Warnung gezeigt
  gehaltIgnorieren Boolean  @default(false) @map("gehalt_ignorieren")

  // Beschäftigungsart – nur Kennzeichnung für Filter/Badge/Statistik in der Anzeige
  beschaeftigungsart Beschaeftigungsart @default(MITARBEITER) @map("beschaeftigungsart")

  abteilungId    String?    @map("abteilung_id")
  abteilung      Abteilung? @relation(fields: [abteilungId], references: [id], onDelete: SetNull)

  erstelltAm     DateTime   @default(now()) @map("erstellt_am")
  aktualisiertAm DateTime   @updatedAt @map("aktualisiert_am")

  gehaltsstufen  GehaltsstufenEintrag[]
  zeitmodelle    ZeitmodellEintrag[]
  ueberstunden   UeberstundenEintrag[]
  schulungsTeilnahmen SchulungsTeilnahme[]

  @@index([nachname, vorname])
  @@map("mitarbeiter")
}

// Eingruppierung (Gruppe+Stufe) – ändert sich selten. Das Zeitmodell (siehe
// ZeitmodellEintrag) ändert sich viel öfter und hat eine eigene Historie mit
// echtem Gültigkeitszeitraum, deshalb bewusst getrennt statt in einem
// kombinierten String wie früher ("B:3.2").
model GehaltsstufenEintrag {
  id             String      @id @default(uuid())
  mitarbeiterId  String      @map("mitarbeiter_id")
  mitarbeiter    Mitarbeiter @relation(fields: [mitarbeiterId], references: [id], onDelete: Cascade)

  // Gruppe/Stufe ODER gehaltAt ist gesetzt, nie beides: AT ("außer Tarif")
  // hat kein Gruppen-System, sondern ein individuell vereinbartes reales
  // Gehalt (Quelle: CSV-Wert "AT:<Betrag>" statt "Zeitmodell:Gruppe.Stufe").
  // Nullable außerdem, weil bei der Umstellung auf structured Felder ein paar
  // historische Einträge nicht automatisch zugeordnet werden konnten.
  gruppe         Int?
  stufe          Int?
  gehaltAt       Decimal?    @map("gehalt_at") @db.Decimal(10, 2)
  gueltigAb      DateTime    @map("gueltig_ab")
  bemerkung      String?

  sitzungId      String?     @map("sitzung_id")
  sitzung        Sitzung?    @relation(fields: [sitzungId], references: [id], onDelete: SetNull)

  erstelltAm     DateTime    @default(now()) @map("erstellt_am")
  aktualisiertAm DateTime    @updatedAt @map("aktualisiert_am")

  @@index([mitarbeiterId, gueltigAb])
  @@map("gehaltsstufen_eintraege")
}

enum Zeitmodell {
  A
  B
  C
  D
}

// Zeitmodell-Historie mit echtem Gültigkeitszeitraum (gueltigBis = null heißt
// unbefristet). Getrennt von der Eingruppierung, weil sich das Zeitmodell viel
// öfter ändert (befristet von 1 Monat bis unbefristet) und aus anderen
// Gründen als die Gehaltsstufe.
model ZeitmodellEintrag {
  id             String      @id @default(uuid())
  mitarbeiterId  String      @map("mitarbeiter_id")
  mitarbeiter    Mitarbeiter @relation(fields: [mitarbeiterId], references: [id], onDelete: Cascade)

  zeitmodell     Zeitmodell
  gueltigVon     DateTime    @map("gueltig_von")
  gueltigBis     DateTime?   @map("gueltig_bis")
  bemerkung      String?

  // Optionale Rückverknüpfung, wenn der Eintrag direkt aus einem Sitzungs-TOP
  // heraus angelegt wurde (siehe TopGehaltModal in Sitzungen.tsx) – wie bei
  // GehaltsstufenEintrag.sitzungId.
  sitzungId      String?     @map("sitzung_id")
  sitzung        Sitzung?    @relation(fields: [sitzungId], references: [id], onDelete: SetNull)

  erstelltAm     DateTime    @default(now()) @map("erstellt_am")
  aktualisiertAm DateTime    @updatedAt @map("aktualisiert_am")

  @@index([mitarbeiterId, gueltigVon])
  @@map("zeitmodell_eintraege")
}

// Überstunden-Regelung mit echtem Gültigkeitszeitraum – strukturell wie
// ZeitmodellEintrag, nur ohne festes Enum: die Regelung selbst ist Freitext
// (z.B. "Ausgleich in Freizeit", "Auszahlung ab 20h").
model UeberstundenEintrag {
  id             String      @id @default(uuid())
  mitarbeiterId  String      @map("mitarbeiter_id")
  mitarbeiter    Mitarbeiter @relation(fields: [mitarbeiterId], references: [id], onDelete: Cascade)

  regelung       String
  gueltigVon     DateTime    @map("gueltig_von")
  gueltigBis     DateTime?   @map("gueltig_bis")
  bemerkung      String?

  // Optionale Rückverknüpfung, wenn der Eintrag direkt aus einem Sitzungs-TOP
  // heraus angelegt wurde (siehe TopGehaltModal in Sitzungen.tsx) – wie bei
  // GehaltsstufenEintrag.sitzungId.
  sitzungId      String?     @map("sitzung_id")
  sitzung        Sitzung?    @relation(fields: [sitzungId], references: [id], onDelete: SetNull)

  erstelltAm     DateTime    @default(now()) @map("erstellt_am")
  aktualisiertAm DateTime    @updatedAt @map("aktualisiert_am")

  @@index([mitarbeiterId, gueltigVon])
  @@map("ueberstunden_eintraege")
}

// ================================================================
//  BETRIEBSVEREINBARUNGEN (Register)
// ================================================================

enum BVStatus {
  AKTIV
  GEKUENDIGT
  ABGELOEST
  BEFRISTET_AUSGELAUFEN
}

model Betriebsvereinbarung {
  id              String   @id @default(uuid())
  titel           String
  abschlussdatum  DateTime
  geltungsbereich String?
  status          BVStatus @default(AKTIV)
  laufzeitEnde    DateTime? @map("laufzeit_ende") // Kündigungsfrist bzw. befristetes Enddatum
  bemerkung       String?

  dokumentId      String?   @map("dokument_id")
  dokument        Dokument? @relation(fields: [dokumentId], references: [id], onDelete: SetNull)

  erstelltVonId   String    @map("erstellt_von_id")
  erstelltVon     Benutzer  @relation("BVErstellt", fields: [erstelltVonId], references: [id])

  erstelltAm      DateTime  @default(now()) @map("erstellt_am")
  aktualisiertAm  DateTime  @updatedAt @map("aktualisiert_am")

  @@index([status])
  @@index([laufzeitEnde])
  @@map("betriebsvereinbarungen")
}

// Geschäftsordnung des Betriebsrats (§ 36 BetrVG) – reine Dokument-Referenz, meist nur
// 1-3 Einträge über die Jahre (aktuelle Fassung + abgelöste Vorgänger), daher kein eigener
// Status wie bei Betriebsvereinbarung, nur das Beschlussdatum entscheidet, welche aktuell gilt.
model Geschaeftsordnung {
  id             String   @id @default(uuid())
  beschlossenAm  DateTime @map("beschlossen_am")
  bemerkung      String?

  dokumentId     String?   @map("dokument_id")
  dokument       Dokument? @relation(fields: [dokumentId], references: [id], onDelete: SetNull)

  erstelltVonId  String   @map("erstellt_von_id")
  erstelltVon    Benutzer @relation("GeschaeftsordnungErstellt", fields: [erstelltVonId], references: [id])

  erstelltAm     DateTime @default(now()) @map("erstellt_am")
  aktualisiertAm DateTime @updatedAt @map("aktualisiert_am")

  @@index([beschlossenAm])
  @@map("geschaeftsordnungen")
}

// ================================================================
//  SCHULUNGSVERWALTUNG / QUALIFIKATIONSMATRIX
// ================================================================

enum SchulungsStatus {
  GEPLANT
  ABSOLVIERT
  ABGESAGT
}

model Qualifikation {
  id                      String   @id @default(uuid())
  name                    String   @unique
  beschreibung            String?
  gueltigkeitsdauerMonate Int?     @map("gueltigkeitsdauer_monate") // z.B. Ersthelfer alle 24 Monate; leer = unbegrenzt gültig

  erstelltAm              DateTime @default(now()) @map("erstellt_am")
  aktualisiertAm          DateTime @updatedAt @map("aktualisiert_am")

  termine                 Schulungstermin[]

  @@map("qualifikationen")
}

model Schulungstermin {
  id              String          @id @default(uuid())
  qualifikationId String          @map("qualifikation_id")
  qualifikation   Qualifikation   @relation(fields: [qualifikationId], references: [id])

  titel           String?
  datum           DateTime
  ort             String?
  anbieter        String?
  kosten          Float?
  status          SchulungsStatus @default(GEPLANT)
  bemerkung       String?

  teilnehmer      SchulungsTeilnahme[]

  erstelltVonId   String          @map("erstellt_von_id")
  erstelltVon     Benutzer        @relation("SchulungErstellt", fields: [erstelltVonId], references: [id])

  erstelltAm      DateTime        @default(now()) @map("erstellt_am")
  aktualisiertAm  DateTime        @updatedAt @map("aktualisiert_am")

  @@index([datum])
  @@index([qualifikationId])
  @@map("schulungstermine")
}

model SchulungsTeilnahme {
  id                String          @id @default(uuid())
  schulungsterminId String          @map("schulungstermin_id")
  schulungstermin   Schulungstermin @relation(fields: [schulungsterminId], references: [id], onDelete: Cascade)

  mitarbeiterId     String          @map("mitarbeiter_id")
  mitarbeiter       Mitarbeiter     @relation(fields: [mitarbeiterId], references: [id], onDelete: Cascade)

  teilgenommen      Boolean         @default(true) // false = angemeldet, aber nicht erschienen/abgesagt

  erstelltAm        DateTime        @default(now()) @map("erstellt_am")

  @@unique([schulungsterminId, mitarbeiterId])
  @@map("schulungs_teilnahmen")
}

// ================================================================
//  GESETZESTEXTE (statischer Import von gesetze-im-internet.de)
// ================================================================

model GesetzParagraph {
  id             String   @id @default(uuid())

  gesetzSlug     String   @map("gesetz_slug")    // z.B. "betrvg" (URL-Teil bei gesetze-im-internet.de)
  gesetz         String                          // Anzeigename, z.B. "BetrVG"
  paragraph      String                          // z.B. "§ 1" oder "§ 14a"
  titel          String?
  text           String                          // reiner Fließtext, ohne Formatierung

  quelleUrl      String   @map("quelle_url")

  aktualisiertAm DateTime @updatedAt @map("aktualisiert_am")

  @@unique([gesetzSlug, paragraph])
  @@index([gesetzSlug])
  @@map("gesetz_paragraphen")
}

// ================================================================
//  KUMMERKASTEN (öffentliches, nicht eingeloggtes Formular für die
//  Belegschaft – bewusst ohne Bezug zu Benutzer/Auth beim Absender,
//  um echte Anonymität zu ermöglichen)
// ================================================================

enum KummerkastenStatus {
  NEU
  IN_BEARBEITUNG
  ERLEDIGT
}

model KummerkastenEintrag {
  id              String             @id @default(uuid())
  nachricht       String
  absenderName    String?            @map("absender_name")
  status          KummerkastenStatus @default(NEU)
  notiz           String?            // interne BR-Notiz, für den Absender nie sichtbar

  bearbeitetVonId String?            @map("bearbeitet_von_id")
  bearbeitetVon   Benutzer?          @relation(fields: [bearbeitetVonId], references: [id], onDelete: SetNull)
  bearbeitetAm    DateTime?          @map("bearbeitet_am")

  erstelltAm      DateTime           @default(now()) @map("erstellt_am")

  @@map("kummerkasten_eintraege")
}
