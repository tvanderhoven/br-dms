# Deploy-Konfiguration – nur für deploy_komplett.py / deploy_update.*
# cp .env.deploy.example .env.deploy  ->  Werte anpassen (wird nicht committet)
# Enthält keine Passwörter oder Secrets
# SSH-Benutzer = Verwaltungskonto des NAS (nicht "admin", Handbuch 11.3)
NAS_USER=br-verwaltung
NAS_HOST=192.168.1.100
DATA_PATH=/volume1/docker/br-dms

# Optional: Pfad zum docker-Programm auf dem Host. Leer = automatisch am DATA_PATH erkennen:
#   /share/...  -> QNAP:     /share/CACHEDEV1_DATA/.qpkg/container-station/bin/docker
#   /volume...  -> Synology: /usr/local/bin/docker
#   sonst       -> docker
# DOCKER_BIN=/usr/local/bin/docker
