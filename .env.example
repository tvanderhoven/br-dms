# ================================================================
#  BR-DMS – Konfiguration (Vorlage)
#
#  Einfacher: bash installation.sh – der Assistent fragt alles ab,
#  erzeugt die Schlüssel und schreibt diese Datei fertig ausgefüllt.
#
#  Von Hand:  cp .env.example .env  ->  alle BITTE_AENDERN ersetzen.
#  Die .env niemals committen oder weitergeben.
#  Startet das Backend nicht, steht der Grund im Log:
#  docker compose logs backend
# ================================================================

# --- Datenverzeichnis auf dem Host --------------------------------
# Hier liegen Datenbank, verschlüsselte Dokumente, Logs, Backups, Zertifikat.
# Synology: /volume1/docker/br-dms   QNAP: /share/Container/br-dms
# Linux-Server: z. B. /srv/br-dms     (relativ wie ./data geht auch)
DATA_PATH=/srv/br-dms

# IP-Adresse oder Name, unter der BR-DMS im Netz erreichbar ist
NAS_IP=192.168.1.100

# Benutzer-/Gruppen-ID, der die Dateien gehören (auf dem Host: id)
# Linux meist 1000/1000, QNAP meist 1000/100, Synology meist 1026/100
PUID=1000
PGID=1000

# --- Datenbank ----------------------------------------------------
# Passwort nur aus Buchstaben, Ziffern, - und _ (z. B. openssl rand -hex 24)
POSTGRES_USER=brdms
POSTGRES_PASSWORD=BITTE_AENDERN
POSTGRES_DB=brdms

# --- Schlüssel ----------------------------------------------------
NODE_ENV=production

# Signiert die Anmeldungen: openssl rand -hex 32
JWT_SECRET=BITTE_AENDERN

# Verschlüsselt alle Dokumente (genau 64 Hex-Zeichen): openssl rand -hex 32
# ACHTUNG: Ohne diesen Schlüssel sind alle Dokumente verloren – separat sichern.
# Bei Umzug/Restore den alten Schlüssel übernehmen, nicht neu erzeugen.
ENCRYPTION_KEY=BITTE_AENDERN

# Verschlüsselt die Backups von backup.sh (Datenbank + Dokumente): openssl rand -hex 32
# Nur backup.sh/restore.sh lesen ihn, der Container nicht. Leer = Backups unverschlüsselt (Warnung).
# ACHTUNG: Ohne diesen Schlüssel lassen sich verschlüsselte Backups nicht wiederherstellen.
BACKUP_KEY=

# Speicherpfad im Container (nicht ändern)
STORAGE_PATH=/data/storage

# --- Erster Admin-Account ------------------------------------------
# Wird beim allerersten Start angelegt (nur solange es noch keinen Benutzer gibt).
# Passwort mindestens 8 Zeichen; danach in der App ändern.
ADMIN_EMAIL=admin@br-dms.lokal
ADMIN_PASSWORD=BITTE_AENDERN

# --- Adresse für Links in E-Mails und als erlaubte Herkunft (CORS) -
# Muss genau die Adresse sein, die im Browser steht – mit https und Port
APP_URL=https://192.168.1.100:8443

# --- E-Mail (optional) --------------------------------------------
# Für Einladungen, Fristen-Erinnerungen und "Passwort vergessen".
# Leer lassen = kein Mailversand, alles andere funktioniert.
# Port 587 = STARTTLS, 465 = SSL
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Watch-Folder (optional) --------------------------------------
# true = Dateien aus dem Eingangsordner automatisch importieren
WATCH_FOLDER_ENABLED=false
# Pfad im Container (nicht ändern)
WATCH_FOLDER=/data/watch_inbox
# Eingangsordner auf dem Host; leer = DATA_PATH/watch_inbox
# Besser eine eigene Freigabe, z. B. /volume1/br-dms-eingang
WATCH_INBOX_PATH=
# Konto, dem Importe zugeordnet werden; leer = erstes Admin-Konto
SYSTEM_USER_ID=

# --- HTTPS-Proxy ---------------------------------------------------
# Aufruf über https://<NAS_IP>:<PROXY_HTTPS_PORT>
# 443/80 nur eintragen, wenn sie auf dem Host frei sind
PROXY_HTTPS_PORT=8443
PROXY_HTTP_PORT=8080
