# ================================================================
#  BR-DMS – Konfiguration
#  cp .env.example .env  ->  Werte anpassen  ->  niemals committen
# ================================================================

# --- NAS-Pfad (einzige plattformspezifische Einstellung) --------
# Synology: DATA_PATH=/volume1/docker/br-dms
# QNAP:     DATA_PATH=/share/Container/br-dms
DATA_PATH=/share/Container/br-dms

# --- SSH-Ziel fuer Deploy-Skripte (lokale Entwicklung) ----------
# NAS_USER und NAS_HOST werden von den deploy_*.py Skripten genutzt
NAS_USER=admin
NAS_HOST=NAS

# --- NAS-Benutzer-IDs (ermitteln mit: id <dein-user> per SSH) ---
# QNAP:     meist 1000/100   Synology: meist 1026/100
PUID=1000
PGID=100

# --- Datenbank --------------------------------------------------
POSTGRES_USER=brdms
POSTGRES_PASSWORD=BITTE_AENDERN_min32Zeichen_zufaellig
POSTGRES_DB=brdms

# --- Backend ----------------------------------------------------
NODE_ENV=production
BACKEND_PORT=4000

# JWT: openssl rand -hex 32
JWT_SECRET=BITTE_AENDERN_openssl_rand_hex_32

# AES-256-Schluessel (32 Bytes = 64 Hex-Zeichen): openssl rand -hex 32
# ACHTUNG: Verlust dieses Schluessels = alle Dokumente unleserlich
ENCRYPTION_KEY=BITTE_AENDERN_openssl_rand_hex_32

# Speicherpfad im Container (entspricht dem Volume-Mount, nicht aendern)
STORAGE_PATH=/data/storage

# --- Erster Admin-Account (nur fuer "npx prisma db seed") -------
# Wird einmalig beim Seed verwendet um den ersten Login-Account anzulegen.
# Danach in den Einstellungen sofort das Passwort aendern.
ADMIN_EMAIL=admin@br-dms.lokal
ADMIN_PASSWORD=BITTE_AENDERN

# --- E-Mail (Passwort-Reset) ------------------------------------
# Beispiel Gmail: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
# Beispiel eigener Server: SMTP_HOST=mail.firma.de  SMTP_PORT=587
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_USER=deine@domain.de
SMTP_PASS=dein-passwort
SMTP_FROM=BR-DMS <deine@domain.de>
# Oeffentliche URL des NAS (fuer den Link in der Passwort-Reset-E-Mail)
APP_URL=http://192.168.1.100:3000

# --- Watch-Folder (optional) ------------------------------------
# Pfad zum Eingangs-Ordner im Container (Volume-Mount, nicht aendern)
WATCH_FOLDER=/data/watch_inbox
# Auf "true" setzen um den Watch-Folder-Service zu aktivieren
WATCH_FOLDER_ENABLED=false
# UUID des System-Benutzers (Admin), der Watch-Folder-Uploads zugeordnet werden
SYSTEM_USER_ID=
# Optionaler eigener Pfad fuer den Watch-Inbox-Ordner (z.B. separate NAS-Freigabe).
# Leer lassen = Standard (DATA_PATH/watch_inbox im Docker-Verzeichnis)
# Synology-Beispiel: WATCH_INBOX_PATH=/volume1/br-dms-eingang
WATCH_INBOX_PATH=

# --- Frontend ---------------------------------------------------
FRONTEND_PORT=3000
# IP-Adresse des NAS im Intranet (ermitteln mit: hostname -I | awk '{print $1}')
NAS_IP=192.168.1.100

# --- HTTPS-Proxy (siehe README, Abschnitt "HTTPS aktivieren") ---
# Nicht 443/80, da viele NAS (v.a. QNAP) diese Ports schon fuer die eigene
# Verwaltungsoberflaeche belegen. Bei Bedarf hier auf 443/80 aendern, wenn frei.
PROXY_HTTPS_PORT=8443
PROXY_HTTP_PORT=8080
